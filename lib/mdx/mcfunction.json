{
  "name": "mcfunction",
  "scopeName": "source.mcfunction",
  "fileTypes": ["mcfunction"],
  "repository": {},
  "patterns": [
    { "name": "entity.name.function", "match": "^/?[a-zA-Z0-9_]+" },
    { "name": "string.quoted.double", "match": "\"[^\"]*\"" },
    { "name": "string.quoted.single", "match": "'[^']*'" },
    { "name": "entity.name.tag", "match": "@[a-z]+" },
    { "name": "constant", "match": "\\b(true|false|null)\\b" },
    { "name": "variable.parameter", "match": "[a-zA-Z_][a-zA-Z0-9_]+" },
    { "name": "constant.numeric", "match": "[\\^~0-9\\.-][0-9\\.-]*" }
  ]
}